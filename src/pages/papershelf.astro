---
import Layout from "../layouts/Layout.astro";
import PageSearch from "../components/PageSearch.astro";

const papers = [
  {
    title: "The Google File System (GFS)",
    link: "https://research.google/pubs/the-google-file-system/",
  },
  {
    title: "Dynamo: Amazon's Highly Available Key-value Store",
    link: "https://www.allthingsdistributed.com/files/amazon-dynamo-sosp2007.pdf",
  },
  {
    title:
      "Bigtable: A Distributed Storage System for Structured Data (Includes SSTable)",
    link: "https://static.googleusercontent.com/media/research.google.com/en//archive/bigtable-osdi06.pdf",
  },
  {
    title: "Colossus: Successor to the Google File System (article)",
    link: "https://www.wired.com/2012/07/google-colossus",
  },
  {
    title: "A Survey of Live Virtual Machine Migration Techniques",
    link: "https://journalofcloudcomputing.springeropen.com/articles/10.1186/s13677-017-0092-1",
  },
  {
    title: "Post-Copy Live Migration of Virtual Machines",
    link: "https://www.cs.binghamton.edu/~hines/papers/2009-postcopy.pdf",
  },
  {
    title:
      "Formal Requirements for Virtualizable Third Generation Architectures",
    link: "https://dl.acm.org/doi/10.1145/361011.361073",
  },
  {
    title:
      "Scalable Load Balancing in Networked Systems: A Survey of Recent Advances",
    link: "https://arxiv.org/abs/1806.05444",
  },
  {
    title:
      "A Comparative Study of Load Balancing Algorithms in Cloud Computing Environment",
    link: "https://arxiv.org/abs/1403.6918",
  },
  {
    title:
      "Hey, You, Get Off of My Cloud: Exploring Information Leakage in Third-Party Compute Clouds",
    link: "https://www.cs.rice.edu/~dwallach/pub/ccs09b.pdf",
  },
];
---

<Layout title="Papershelf">
  <section class="max-w-3xl mx-auto px-6 pt-12 pb-20">
    <!-- Search -->
    <div class="flex justify-end mb-8">
      <div class="w-full sm:w-1/2">
        <PageSearch />
      </div>
    </div>

    <!-- Main Heading -->
    <h1 class="text-4xl font-bold text-gray-900 mb-8">Papershelf</h1>

    <!-- Subheading 1 -->
    <h2 class="text-2xl font-semibold text-gray-800 mb-3">My Learning</h2>

    <p class="text-gray-700 mb-4">
      I’ve always been curious about how things work under the hood — not just
      how to use a tool, but why it was built that way. That curiosity led me to
      explore research papers and system design articles that power large-scale
      systems.
    </p>

    <p class="text-blue-600 font-medium mb-4">
      This page is inspired by the way
      <a
        href="https://arpitbhayani.me/"
        target="_blank"
        class="hover:underline"
      >
        Arpit Bhayani
      </a>
      approaches learning —
      <a
        href="https://youtu.be/V5-KxHdmbDo?si=3FH1e9sdEMMgHkps"
        target="_blank"
        class="hover:underline"
      >
        read, understand, and remember a paper
      </a>.
    </p>

    <p class="text-gray-700 mb-2 font-medium">My process:</p>

    <ul class="list-disc pl-6 text-gray-700 mb-6 space-y-1">
      <li>
        <strong>First Pass:</strong> Skim for a high-level overview and identify
        key ideas
      </li>
      <li><strong>Second Pass:</strong> Read deeply and connect concepts</li>
      <li>
        <strong>Third Pass:</strong> Write notes as if teaching to build strong mental
        models
      </li>
    </ul>
    <!-- Subheading 2 -->
    <h2 class="text-2xl font-semibold text-gray-800 mb-3">My Writings</h2>

    <p class="text-gray-700 mb-4">
      Alongside learning through papers, I actively contribute to open source in
      the system design space. I’m a contributor to a well-known repository with
      1K+ stars on GitHub —
      <a
        href="https://github.com/SweetCodey/system-design-masterclass"
        target="_blank"
        class="text-blue-600 hover:underline font-medium"
      >
        System Design Masterclass
      </a>.
    </p>

    <p class="text-gray-700 mb-6">
      My contributions are focused on the
      <a
        href="https://github.com/SweetCodey/system-design-masterclass/tree/main/Common%20Technologies"
        target="_blank"
        class="text-blue-600 hover:underline font-medium"
      >
        Common Technologies
      </a>, where I document core technologies used in scalable systems like
      caching, databases, and messaging systems.
    </p>

    <!-- Subheading 3 -->
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">Papers I Read</h2>

    <!-- Bullet Links -->
    <ul class="list-disc pl-6 space-y-2 text-blue-600">
      {
        papers.map((paper) => (
          <li>
            <a href={paper.link} target="_blank" class="hover:underline">
              {paper.title}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
